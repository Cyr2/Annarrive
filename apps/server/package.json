{
  "name": "@annarrive/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "tsx src/index.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p .",
    "eval:reggie": "node --env-file-if-exists=../../.env --import tsx eval/reggie/run.ts",
    "lighthouse": "tsx src/cli/lighthouse.ts",
    "incidents": "node --env-file-if-exists=../../.env --import tsx src/cli/incidents.ts",
    "level": "node --env-file-if-exists=../../.env --import tsx src/cli/level.ts",
    "login-link": "node --env-file-if-exists=../../.env --import tsx src/cli/login-link.ts",
    "users": "node --env-file-if-exists=../../.env --import tsx src/cli/users.ts"
  },
  "dependencies": {
    "@annarrive/coach": "workspace:*",
    "@annarrive/protocol": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@hono/node-server": "^2.1.8",
    "@simplewebauthn/server": "~14.0.3",
    "hono": "^4.13.18",
    "node-ical": "^0.27.6",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
