# Copier en .env et remplir. Ne jamais commiter .env.

# Garmin (compte d'Anna)
# Connexion non officielle (python-garminconnect) : écriture des séances, et lecture de secours.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Clé de la Personal API officielle (lecture seule), créée sur
# https://connect.garmin.com/app/settings/personalApiToken. Vide : toute la lecture passe par la connexion non officielle.
GARMIN_API_KEY=
# off : lit le compte Garmin mais n'y écrit rien (instance de test). Vide : envoi des séances actif.
GARMIN_WRITE=

# Reggie : remplir UNE des deux
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
REGGIE_MODEL=sonnet

# Emploi du temps (lien ICS de l'université)
ICS_URL=

# Notifications Web Push (npx web-push generate-vapid-keys ; PUBLIC_URL doit être en https)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sécurité
SESSION_SECRET=
BRIDGE_SECRET=
BRIDGE_URL=

# Adresse publique de l'app. Son hôte est aussi le site des clés d'accès (Face ID) : en changer oblige à les refaire.
# Comptes, dans le conteneur (en local : pnpm --filter @annarrive/server users …) :
#   node --import tsx src/cli/users.ts password <nom>   crée le compte, ou lui donne un nouveau mot de passe (affiché une fois)
#   node --import tsx src/cli/users.ts list             comptes et clés d'accès
#   node --import tsx src/cli/users.ts revoke <id>      supprime une clé d'accès (téléphone perdu)
# Lien de connexion de secours, 15 min (en local : pnpm --filter @annarrive/server login-link) :
#   node --import tsx src/cli/login-link.ts [nom]       avec un nom, propose ensuite Face ID
# Journal des incidents, 30 jours gardés (en local : pnpm --filter @annarrive/server incidents) :
#   node --import tsx src/cli/incidents.ts [--since 2d] [--id <id>] [--json]   du plus récent au plus ancien
PUBLIC_URL=
